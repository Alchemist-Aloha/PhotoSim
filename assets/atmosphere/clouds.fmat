material {
  name: "PhotoSimClouds",
  shading_model: unlit,
  blending: alpha,
  culling: front,
  depth_test: always,
  engine_inputs: [scene_color, scene_depth],
  parameters: [
    { type: vec3, name: cloud_origin, default: [0, 0, 0] },
    { type: vec3, name: seed_offset, default: [0, 0, 0] },
    { type: float, name: animation_time, default: 0 },
    { type: vec4, name: layer, default: [2.2, 4.3, 1.3, 3.5] },
    { type: vec3, name: sun_direction, default: [0, 1, 0] },
    { type: vec3, name: sun_color, default: [1, 1, 1] },
    { type: float, name: moon_strength, default: 0 },
    { type: float, name: energy, default: 1 },
    { type: float, name: amount, default: 0 },
    { type: float, name: max_distance, default: 256 },
    { type: int, name: cloud_type, default: 0 },
    { type: int, name: noise_octaves, default: 5 },
    { type: float, name: scene_far, default: 50000 }
  ]
}
fragment {
  precision highp float;

  // Ported from ref/atmospheric-sky-lighting-simulation.zip (computeClouds).
  // Keep this block identical in clouds.fmat and water.fmat: visible and reflected decks.
  float Hash12(vec2 p) {
    vec3 p3 = fract(vec3(p.xyx) * 0.1031);
    p3 += dot(p3, p3.yzx + 33.33);
    return fract((p3.x + p3.y) * p3.z);
  }

  float Noise2(vec2 p) {
    vec2 i = floor(p), f = fract(p);
    vec2 u = f * f * (3.0 - 2.0 * f);
    return mix(mix(Hash12(i), Hash12(i + vec2(1.0, 0.0)), u.x),
      mix(Hash12(i + vec2(0.0, 1.0)), Hash12(i + vec2(1.0)), u.x), u.y);
  }

  float CloudFbm(vec2 p) {
    float value = 0.0, amplitude = 0.5;
    mat2 rotation = mat2(0.80, 0.60, -0.60, 0.80);
    for (int i = 0; i < 5; i++) {
      if (i >= material_params.noise_octaves) break;
      value += amplitude * Noise2(p);
      p = rotation * p * 2.03 + vec2(17.1, 31.7);
      amplitude *= 0.5;
    }
    return value;
  }

  float CloudDistance(vec3 ray, float height, float observerHeight) {
    float radius = 6371.0 + observerHeight;
    float b = radius * ray.y;
    float c = (observerHeight - height) * (2.0 * 6371.0 + observerHeight + height);
    float d = b * b - c;
    if (d < 0.0) return -1.0;
    float root = sqrt(d);
    // Keep the near intersection when looking down on a deck from above.
    return -b - root > 0.0 ? -b - root : -b + root;
  }

  vec4 CloudDeck(vec3 ray, vec3 origin, vec3 skyColor, float limitKm) {
    if (material_params.amount <= 0.0) return vec4(0.0);
    float lowHeight = material_params.layer.x;
    float highHeight = max(lowHeight + material_params.layer.y, lowHeight + 4.3);
    bool cirrus = material_params.cloud_type == 3;
    if (cirrus) highHeight = lowHeight;
    float lowDistance = CloudDistance(ray, lowHeight, origin.y);
    float highDistance = CloudDistance(ray, highHeight, origin.y);
    float wind = material_params.animation_time * 0.055;
    vec2 anchor = origin.xz + material_params.cloud_origin.xz;
    vec2 seed = material_params.seed_offset.xz;
    // The reference's softened projection avoids a compressed stripe at the horizon.
    float lowProjection = min(max(lowDistance, 0.0),
      abs(lowHeight - origin.y) / max(0.025, abs(ray.y) + 0.035));
    float highProjection = min(max(highDistance, 0.0),
      abs(highHeight - origin.y) / max(0.02, abs(ray.y) + 0.03));
    vec2 lowUv = (anchor + ray.xz * lowProjection) * 0.18 + seed + vec2(wind, wind * 0.35);
    vec2 highUv = (anchor + ray.xz * highProjection) * 0.11 + seed + vec2(wind * 1.4, -wind * 0.25);
    float scale = clamp(1.3 / material_params.layer.z, 0.45, 1.5);
    float threshold = mix(0.84, 0.30, material_params.amount);
    bool stratus = material_params.cloud_type == 2;
    bool lowVisible = !cirrus && lowDistance > 0.0 && lowDistance < limitKm;
    bool highVisible = highDistance > 0.0 && highDistance < limitKm;
    // Skip noise that cannot change the result: occluded decks, and detail octaves
    // where even a maximal detail (< 0.97) cannot lift raw past the threshold.
    if (!lowVisible && !highVisible) return vec4(0.0);
    float base = CloudFbm(lowUv * 1.4 * scale);
    float raw = mix(base, 0.5, 0.32);
    if (stratus || (lowVisible && mix(base, 0.97, 0.32) > threshold)) {
      raw = mix(base, CloudFbm(lowUv * 3.8 * scale - vec2(wind * 0.4, 0.0)), 0.32);
    }
    float low = smoothstep(threshold, threshold + 0.24, raw);
    float high = 0.0;
    if (highVisible) {
      float highThreshold = mix(0.82, 0.34, material_params.amount);
      high = smoothstep(highThreshold, highThreshold + 0.28, CloudFbm(highUv * vec2(2.2, 0.65)));
    }
    if (material_params.cloud_type == 1) low = min(low * 1.35, 1.0);
    if (stratus) low = mix(low, 1.0, material_params.amount * 0.85);
    if (material_params.cloud_type == 4) low = min(low * 1.5, 1.0);
    if (!lowVisible) low = 0.0;
    high *= cirrus ? 1.0 : 0.35;
    // Spherical decks remain visible at the geometric horizon, including high observers.
    float horizonFade = origin.y > lowHeight ? 1.0 : smoothstep(-0.07, 0.09, ray.y);
    float density = clamp(low + high * 0.72, 0.0, 1.0) * horizonFade;
    if (density < 0.002) return vec4(0.0);
    float height = mix(lowHeight, highHeight, high / max(0.001, low + high));
    vec3 sun = normalize(material_params.sun_direction);
    float dip = asin(clamp(sun.y, -1.0, 1.0));
    float horizonDip = -sqrt(max(0.0, 2.0 * height / 6371.0)) - 0.012;
    float sunlight = smoothstep(horizonDip - 0.055, horizonDip + 0.03, dip);
    float mu = max(dot(ray, sun), 0.0);
    // Thin edges forward-scatter (silver lining); thick backlit cores stay dark.
    float forwardGlow = (pow(mu, 6.0) * 1.4 + pow(mu, 32.0) * 2.2) *
      mix(1.8, 0.45, clamp(low + high * 0.72, 0.0, 1.0));
    float selfShadow = smoothstep(0.0, 0.85, raw);
    // Twilight sky keeps lighting cloud bases through civil twilight (~-3.5° to -14°).
    float night = 1.0 - smoothstep(-0.24, -0.06, sun.y);
    vec3 ambient = mix(skyColor * 0.55,
      vec3(0.00004, 0.00007, 0.00014), night);
    vec3 direct = material_params.sun_color * sunlight *
      (2.6 + forwardGlow) * (1.15 - 0.55 * selfShadow);
    float underlight = exp(-pow((dip + 0.025) / 0.045, 2.0));
    direct += vec3(1.15, 0.36, 0.28) * material_params.sun_color *
      sunlight * underlight * (cirrus ? 1.0 : 0.55) * (1.1 - 0.5 * selfShadow);
    if (material_params.cloud_type == 4) direct *= 0.65;
    vec3 moon = vec3(0.0010, 0.0014, 0.0022) * material_params.moon_strength;
    vec3 color = (ambient * 0.75 + direct * 0.85 + moon) * material_params.energy;
    color = mix(color, skyColor, exp(-max(0.0, ray.y) * 5.0) * 0.58);
    return vec4(color, clamp(density * 0.88, 0.0, 0.94));
  }
  // End shared reference cloud block.

  void Surface(inout MaterialInputs material) {
    vec3 ray = -normalize(v_viewvector);
    float limit = material_params.max_distance;
    float sceneDepth = GetSceneDepth(vec2(0.0));
    if (sceneDepth < material_params.scene_far - 1.0) {
      limit = min(limit, sceneDepth /
        max(dot(ray, frag_info.camera_forward.xyz), 0.001) / 1000.0);
    }
    material.base_color = CloudDeck(ray,
      vec3(0.0, material_params.cloud_origin.y, 0.0),
      GetSceneColor(vec2(0.0)), limit);
  }
}
