material {
  name: "PhotoSimAtmosphere",
  parameters: [
    { type: sampler2D, name: multiple_scattering, hint: default_black },
    { type: vec3, name: sun_direction, default: [0, 1, 0] },
    { type: vec3, name: moon_direction, default: [0, -1, 0] },
    { type: vec3, name: rayleigh, default: [0.0058, 0.0135, 0.0331] },
    { type: vec3, name: mie, default: [0.0003, 0.00032, 0.00035] },
    { type: vec3, name: mie_absorption, default: [0, 0, 0] },
    { type: vec3, name: ozone, default: [0.000650, 0.001881, 0.000085] },
    { type: vec3, name: ground_color, default: [0.12, 0.12, 0.13] },
    { type: float, name: solar_radius, default: 0.0047 },
    { type: float, name: aerosol_height, default: 1.25 },
    { type: float, name: sun_flatten, default: 0 },
    { type: float, name: sun_disk_scale, default: 80 },
    { type: float, name: energy, default: 1 },
    { type: float, name: lunar_radiance, default: 0 },
    { type: float, name: observer_height, default: 0.002 },
    { type: float, name: eccentricity, default: 0.76 },
    { type: int, name: view_samples, default: 8 },
    { type: int, name: light_samples, default: 8 }
  ]
}
sky {
  // Spherical Rayleigh/Mie scattering with stratospheric ozone absorption, in kilometres.
  const float ATM_R = 6371.0;
  const float ATM_TOP = 6451.0;
  const float ATM_PI = 3.14159265359;

  float ExitAtmosphere(vec3 p, vec3 direction) {
    float b = dot(p, direction);
    return -b + sqrt(max(b * b + ATM_TOP * ATM_TOP - dot(p, p), 0.0));
  }

  vec3 Density(vec3 p) {
    float height = max(length(p) - ATM_R, 0.0);
    // Earth ozone layer: triangular density from 10 to 40 km, peaking at 25 km.
    return vec3(exp(-height / vec2(8.4, material_params.aerosol_height)), max(0.0, 1.0 - abs(height - 25.0) / 15.0));
  }

  vec3 LightDepth(vec3 p, vec3 light) {
    float b = dot(p, light);
    float shadowDepth = 0.0;
    // The curved Earth's shadow has a soft terminator, so the setting Sun fades
    // through the refracted limb instead of switching off at the horizon.
    if (b < 0.0) {
      float miss = sqrt(max(dot(p, p) - b * b, 0.0)) - ATM_R;
      float shadow = smoothstep(-8.0, 8.0, miss);
      if (shadow <= 0.0) return vec3(1e6);
      shadowDepth = -log(shadow);
    }
    float distance = ExitAtmosphere(p, light);
    vec3 optical = vec3(0.0);
    float previous = 0.0;
    for (int j = 0; j < 12; j++) {
      if (j >= material_params.light_samples) break;
      float fraction = float(j + 1) / float(material_params.light_samples);
      float next = distance * fraction * fraction;
      optical += Density(p + light * (previous + next) * 0.5) * (next - previous);
      previous = next;
    }
    return optical + vec3(shadowDepth);
  }

  vec3 Extinction(vec3 optical) {
    return material_params.rayleigh * optical.x
      + (material_params.mie + material_params.mie_absorption) * optical.y
      + material_params.ozone * optical.z;
  }

  vec3 Transmission(vec3 optical) {
    return exp(-Extinction(optical));
  }

  // shortcut: LUT uses fixed clear-air coefficients; rebake if atmospheric defaults change.
  vec3 MultipleScattering(vec3 p, vec3 light) {
    float height = clamp((length(p) - ATM_R) / 80.0, 0.0, 1.0);
    float mu = clamp(dot(normalize(p), light), -1.0, 1.0);
    // Inverse of the LUT's squared height and signed-squared solar cosine grids.
    vec2 uv = vec2(0.5 + 0.5 * sign(mu) * sqrt(abs(mu)), sqrt(height));
    uv = (uv * vec2(63.0, 31.0) + 0.5) / vec2(64.0, 32.0);
    vec3 encoded = texture(multiple_scattering, uv).rgb;
    return encoded * encoded;
  }

  vec2 Phase(float cosine) {
    float g = material_params.eccentricity;
    float g2 = g * g;
    // Cornette–Shanks: the reference aureole, stronger forward scattering than Henyey–Greenstein.
    return vec2(3.0 * (1.0 + cosine * cosine) / (16.0 * ATM_PI),
      3.0 * (1.0 - g2) * (1.0 + cosine * cosine)
        / (8.0 * ATM_PI * (2.0 + g2) * pow(max(1.0 + g2 - 2.0 * g * cosine, 0.001), 1.5)));
  }

  vec3 Sky(vec3 direction) {
    vec3 ray = normalize(direction);
    vec3 sun = normalize(material_params.sun_direction);
    vec3 moon = normalize(material_params.moon_direction);
    vec3 origin = vec3(0.0, ATM_R + max(material_params.observer_height, 0.002), 0.0);
    float distance = ExitAtmosphere(origin, ray);
    float b = dot(origin, ray);
    float groundDiscriminant = b * b + ATM_R * ATM_R - dot(origin, origin);
    bool hitsGround = b < 0.0 && groundDiscriminant >= 0.0;
    if (hitsGround) distance = min(distance, -b - sqrt(groundDiscriminant));
    // Split at the curved Earth's shadow edge so a cell cannot abruptly flip lit/unlit.
    float sunCosine = dot(ray, sun);
    float originSun = dot(origin, sun);
    float shadowA = max(1.0 - sunCosine * sunCosine, 1e-6);
    float shadowB = b - originSun * sunCosine;
    float shadowC = dot(origin, origin) - originSun * originSun - ATM_R * ATM_R;
    float litStart = 0.0;
    if (originSun < 0.0 && shadowC < 0.0) {
      litStart = clamp((-shadowB + sqrt(max(shadowB * shadowB - shadowA * shadowC, 0.0)))
        / shadowA, 0.0, distance);
    }
    vec2 sunPhase = Phase(sunCosine);
    vec2 moonPhase = Phase(dot(ray, moon));
    vec3 optical = vec3(0.0);
    vec3 scattered = vec3(0.0);
    float previous = 0.0;
    for (int i = 0; i < 12; i++) {
      if (i >= material_params.view_samples) break;
      float fraction = float(i + 1) / float(material_params.view_samples);
      float next = distance * fraction * fraction;
      if (litStart > 0.0) {
        float local = fraction < 0.5 ? fraction * 2.0 : fraction * 2.0 - 1.0;
        next = fraction < 0.5 ? litStart * local * local
          : litStart + (distance - litStart) * local * local;
      }
      vec3 p = origin + ray * (previous + next) * 0.5;
      vec3 column = Density(p) * (next - previous);
      // Integrate attenuation within each cell: midpoint extinction loses blue on long horizon rays.
      vec3 tau = Extinction(column);
      vec3 segment = (vec3(1.0) - exp(-tau)) / max(tau, vec3(1e-6));
      vec3 viewTransmission = Transmission(optical) * segment;
      vec3 solar = viewTransmission * Transmission(LightDepth(p, sun));
      vec3 scattering = material_params.rayleigh * column.x + material_params.mie * column.y;
      scattered += 20.0 * (solar * (material_params.rayleigh * column.x * sunPhase.x
        + material_params.mie * column.y * sunPhase.y)
        + viewTransmission * scattering * MultipleScattering(p, sun));
      if (material_params.lunar_radiance > 0.0) {
        vec3 lunar = viewTransmission * Transmission(LightDepth(p, moon));
        scattered += material_params.lunar_radiance * (lunar
          * (material_params.rayleigh * column.x * moonPhase.x
          + material_params.mie * column.y * moonPhase.y)
          + viewTransmission * scattering * MultipleScattering(p, moon));
      }
      optical += column;
      previous = next;
    }
    // Belt of Venus: the anti-solar twilight arch beside the Earth's shadow. The
    // isotropic multiple-scattering LUT cannot produce it, so add it spectrally;
    // it fades in from ~+3° and is gone by ~-6° solar altitude.
    vec3 flatRay = normalize(vec3(ray.x, 0.0, ray.z) + vec3(1e-5, 0.0, 0.0));
    vec3 antiSun = normalize(vec3(-sun.x, 0.0, -sun.z) + vec3(1e-5, 0.0, 0.0));
    float antisolar = max(dot(flatRay, antiSun), 0.0);
    float twilight = exp(-pow((sun.y + 0.025) / 0.05, 2.0));
    // Earth's shadow and its rose rim climb together as the Sun descends.
    float shadowEdge = max(-sun.y, 0.0);
    float beltBand = exp(-pow((ray.y - shadowEdge - 0.10) / 0.09, 2.0));
    float shadowBand = 1.0 - smoothstep(shadowEdge, shadowEdge + 0.06, ray.y);
    if (!hitsGround) {
      scattered *= 1.0 - 0.18 * twilight * pow(antisolar, 3.0) * shadowBand;
      scattered += vec3(0.040, 0.015, 0.018) * twilight * pow(antisolar, 6.0) * beltBand;
    }
    // Refraction flattens the setting Sun; the limb is darker than the center.
    vec3 sunOffset = ray - sun;
    vec3 zenith = normalize(origin);
    float vertical = dot(sunOffset, zenith);
    vec3 horizontal = sunOffset - zenith * vertical;
    float flattened = length(horizontal + zenith * vertical * (1.0 + material_params.sun_flatten));
    float limbX = clamp(flattened / material_params.solar_radius, 0.0, 1.0);
    float limb = 1.0 - 0.6 * (1.0 - sqrt(1.0 - limbX * limbX));
    float edgeWidth = max(material_params.solar_radius * 0.06, fwidth(flattened));
    float edge = (1.0 - smoothstep(material_params.solar_radius - edgeWidth,
      material_params.solar_radius + edgeWidth, flattened)) * step(0.0, dot(ray, sun));
    // Extinction and the Earth's limb, not the center altitude, determine disk visibility.
    // shortcut: preview-relative disk radiance avoids highlight desaturation; calibrate for photometric output.
    // A horizon-grazing light path crosses the dense layer within the first few
    // kilometres; a coarse numerical march skips it, so use the Kasten-Young
    // air mass for the disk's extinction instead.
    float sunElevation = asin(clamp(normalize(direction).y, -1.0, 1.0)) * 180.0 / ATM_PI;
    float sunMass = 1.0 / max(sin(sunElevation * ATM_PI / 180.0) +
      0.50572 * pow(max(sunElevation + 6.07995, 0.01), -1.6364), 0.001);
    vec3 sunOptical = material_params.rayleigh * 8.4 * sunMass +
      (material_params.mie + material_params.mie_absorption) *
        material_params.aerosol_height * sunMass +
      material_params.ozone * 15.0 * sunMass;
    vec3 sunTint = exp(-sunOptical);
    vec3 direct = material_params.sun_disk_scale * limb * edge * sunTint;
    if (hitsGround) {
      vec3 p = origin + ray * distance;
      vec3 up = normalize(p);
      p += up * 0.002;
      vec3 groundLight = 20.0 * (Transmission(LightDepth(p, sun))
        * max(dot(up, sun), 0.0) / ATM_PI + MultipleScattering(p, sun));
      if (material_params.lunar_radiance > 0.0) {
        groundLight += material_params.lunar_radiance * (Transmission(LightDepth(p, moon))
          * max(dot(up, moon), 0.0) / ATM_PI + MultipleScattering(p, moon));
      }
      scattered += Transmission(optical) * material_params.ground_color * groundLight;
      direct = vec3(0.0);
    }
    return max((scattered + direct) * material_params.energy, vec3(0.0));
  }
}
